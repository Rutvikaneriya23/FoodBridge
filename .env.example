# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/foodbridge

# JWT Secret Keys
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_ADMIN_SECRET=your_super_secret_admin_jwt_key_change_this_in_production
JWT_EXPIRE=7d
JWT_ADMIN_EXPIRE=1d

# Google OAuth Configuration
# Get your Client ID from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Admin Credentials (Change immediately!)
ADMIN_ID=admin@foodbridge.com
ADMIN_PASSWORD=Admin@FoodBridge2026

# CORS
CLIENT_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
